# Copie para .env.local para testar o formulário de contato localmente.

# Chave do Resend com permissão "Sending access". Sem ela, o formulário mostra um erro em vez de enviar.
RESEND_API_KEY=

# Remetente do e-mail. Sem domínio verificado no Resend, use onboarding@resend.dev,
# que só entrega para o e-mail dono da conta.
MAIL_FROM="Portfólio Guilherme <onboarding@resend.dev>"

